local function createNavIcon(emojiText, isActive)
    local Icon = Instance.new("TextButton")
    Icon.Size = UDim2.new(0, 42, 0, 42)
    Icon.BackgroundColor3 = isActive and Color3.fromRGB(15, 15, 22) or Color3.fromRGB(6, 6, 8)
    Icon.Text = emojiText
    Icon.TextSize = 18
    Icon.TextColor3 = isActive and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(90, 90, 100)
    Icon.Font = Enum.Font.GothamBold
    Icon.AutoButtonColor = false
    Icon.Parent = NavContainer
    
    Instance.new("UICorner", Icon).CornerRadius = UDim.new(0, 6)
    local s = Instance.new("UIStroke", Icon)
    s.Color = isActive and Color3.fromRGB(0, 150, 255) or Color3.fromRGB(15, 15, 20)

    Icon.MouseEnter:Connect(function()
        if Icon.TextColor3 ~= Color3.fromRGB(255, 255, 255) then
            TweenService:Create(Icon, TWEEN_INFO, {TextColor3 = Color3.fromRGB(200, 200, 200)}):Play()
        end
    end)
    Icon.MouseLeave:Connect(function()
        if Icon.TextColor3 ~= Color3.fromRGB(255, 255, 255) then
            TweenService:Create(Icon, TWEEN_INFO, {TextColor3 = Color3.fromRGB(90, 90, 100)}):Play()
        end
    end)
end

